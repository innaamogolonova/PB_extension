{
  "name": "pb_extension",
  "displayName": "PB Extension",
  "description": "LLM-powered debugger setup for Python in VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:pbExtension.bugSpecView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pbExtension.setupDebuggerFromDescription",
        "title": "Set Up Debugger From Description…",
        "category": "PB Extension"
      },
      {
        "command": "pbExtension.clearAssistantSetup",
        "title": "Clear Assistant Debugger Setup",
        "category": "PB Extension"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "pbDebugger",
          "title": "PB Debugger",
          "icon": "$(debug-alt)"
        }
      ]
    },
    "views": {
      "pbDebugger": [
        {
          "type": "webview",
          "id": "pbExtension.bugSpecView",
          "name": "Bug description"
        }
      ]
    },
    "configuration": {
      "title": "PB Extension",
      "properties": {
        "pbExtension.openaiApiKey": {
          "type": "string",
          "default": ""
        },
        "pbExtension.pythonInterpreter": {
          "type": "string",
          "default": "",
          "description": "Python executable for launching/debugging (e.g. python3 or /usr/bin/python3). Empty uses python3."
        }
      }
    }
  },
  "menus": {},
  "keybindings": [],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "openai": "^6.21.0"
  }
}
